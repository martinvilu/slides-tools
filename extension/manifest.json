{
  "manifest_version": 3,
  "name": "Google Slides Remote Control Bridge",
  "version": "1.2.0",
  "description": "Control remoto y telemetría bidireccional para Google Slides con soporte de app móvil y hardware Wi-Fi.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/presentation/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "content-present.js",
        "content-speaker.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Slides Bridge"
  }
}
